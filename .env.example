# ============================================================
# VAANIFLOW MASTER ENVIRONMENT CONFIGURATION
# ============================================================

# --- BACKEND SERVER (server/.env) ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- SUPABASE DATABASE ---
# Direct PostgreSQL connection URI from Supabase Dashboard > Settings > Database
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Project API Credentials
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_KEY]

# --- MURF AI VOICE SYNTHESIS ---
# Obtain from https://api.murf.ai/
MURF_API_KEY=[YOUR_MURF_API_KEY]

# --- GOOGLE GEMINI AI ---
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]

# --- JWT AUTHENTICATION ---
JWT_SECRET=vaaniflow_hackathon_jwt_secret_super_secure_key_2026

# --- FRONTEND (client/.env) ---
VITE_API_URL=
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=[SUPABASE_ANON_KEY]
