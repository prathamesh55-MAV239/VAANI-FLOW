# ============================================================
# VAANIFLOW SERVER CONFIGURATION TEMPLATE
# Copy this file to .env and insert your real provider credentials
# ============================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# SUPABASE DATABASE CONFIGURATION
# ------------------------------------------------------------
# Option A: Supabase Connection Pooler / Direct Postgres URI (Recommended)
# e.g.: postgresql://postgres.abcdefghijklmno:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Option B: Supabase Project API Credentials
# e.g.: https://abcdefghijklmno.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------
# MURF AI VOICE SYNTHESIS CONFIGURATION
# ------------------------------------------------------------
# Obtain from https://api.murf.ai/
MURF_API_KEY=

# ------------------------------------------------------------
# GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------
# OPTIONAL PROVIDER KEYS
# ------------------------------------------------------------
STT_API_KEY=
TTS_API_KEY=

# ------------------------------------------------------------
# JWT AUTHENTICATION SECRET
# ------------------------------------------------------------
JWT_SECRET=vaaniflow_hackathon_jwt_secret_super_secure_key_2026
